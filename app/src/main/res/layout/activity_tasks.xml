<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D28"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <!-- زر الرجوع -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="رجوع  ←"
            android:textAllCaps="false"
            android:textColor="#77A7FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/button_rounded"
            android:backgroundTint="#16213A"
            android:elevation="6dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="34dp"/>

        <!-- العنوان -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📝  تسجيل مهمة"
            android:textColor="#FFFFFF"
            android:textSize="31sp"
            android:textStyle="bold"
            android:shadowColor="#4A7DFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"/>

        <View
            android:layout_width="76dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:background="#3D7BFF"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp"/>

        <!-- البطاقة الرئيسية -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#141D34"
            app:cardCornerRadius="26dp"
            app:cardElevation="12dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="26dp">

                <!-- نوع المهمة -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نوع المهمة"
                    android:textColor="#E8ECF8"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#202B49"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <Spinner
                        android:id="@+id/spinnerTaskType"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:spinnerMode="dropdown"
                        android:popupBackground="#202B49"/>

                </androidx.cardview.widget.CardView>

                <!-- التاريخ -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التاريخ"
                    android:textColor="#E8ECF8"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#202B49"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <EditText
                        android:id="@+id/editDate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:hint="📅   اختر التاريخ"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B5C2E3"
                        android:textSize="16sp"/>

                </androidx.cardview.widget.CardView>

                <!-- الوقت -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الوقت (من - إلى)"
                    android:textColor="#E8ECF8"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#202B49"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <EditText
                        android:id="@+id/editTimeRange"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:hint="🕒   اختر الوقت (00:00 - 00:00)"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B5C2E3"
                        android:textSize="16sp"/>

                </androidx.cardview.widget.CardView>

                <!-- مدة المذاكرة -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مدة المذاكرة للمهمة"
                    android:textColor="#E8ECF8"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#202B49"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <EditText
                        android:id="@+id/editDuration"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:hint="⏱   اختر مدة المذاكرة للمهمة"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B5C2E3"
                        android:textSize="16sp"/>

                </androidx.cardview.widget.CardView>

                <!-- المادة المرتبطة -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المادة المرتبطة"
                    android:textColor="#E8ECF8"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#202B49"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <Spinner
                        android:id="@+id/spinnerSubject"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:spinnerMode="dropdown"
                        android:popupBackground="#202B49"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp"/>

        <!-- حفظ المهمة -->

        <Button
            android:id="@+id/btnSaveTask"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="💾  حفظ المهمة"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/button_rounded"
            android:backgroundTint="#356DFF"
            android:elevation="12dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp"/>

        <!-- عرض المهام -->

        <Button
            android:id="@+id/btnShowTasks"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="☷  عرض المهام المسجلة"
            android:textAllCaps="false"
            android:textColor="#6FA1FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/button_rounded"
            android:backgroundTint="#151F36"
            android:elevation="7dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

    </LinearLayout>

</ScrollView>